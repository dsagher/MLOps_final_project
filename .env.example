# Copy to .env and fill in. Do not quote values, add spaces around "=", or commit .env.
# Get a free key at https://data.bls.gov/registrationEngine/
API_KEY=

# Input CSVs used by the `make build_*` targets
NATIONAL_SERIES_FILE=data/inputs/national_series.csv
STATE_SERIES_FILE=data/inputs/state_series.csv

# PostgreSQL connection (SQLAlchemy URL parts)
DB_DRIVER=postgresql+psycopg2
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_DATABASE=bls
DB_PORT=5432

# Optional, only for the Airflow refresh DAG: absolute path to <repo>/data/airflow.
# Airflow does not read this file; export it in the shell that starts Airflow.
AIRFLOW_HOME=/absolute/path/to/repo/data/airflow
