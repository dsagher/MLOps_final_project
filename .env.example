# Copy to .env and fill in. Do not quote values, add spaces around "=", or commit .env.
# Get a free key at https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Input CSVs used by `make build_national` / `make build_state`
NATIONAL_SERIES_FILE=data/inputs/national_series.csv
STATE_SERIES_FILE=data/inputs/state_series.csv

# PostgreSQL connection (SQLAlchemy URL parts)
DB_DRIVER=postgresql+psycopg2
DB_USERNAME=
DB_PASSWORD=
DB_HOST=localhost
DB_DATABASE=bls
DB_PORT=5432
